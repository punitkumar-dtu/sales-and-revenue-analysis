      <aliases enabled='yes' />
      <column caption='profit margin %' datatype='real' name='[Calculation_1864935756546048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales])' />
      </column>
      <column caption='order to ship date' datatype='integer' name='[Calculation_1864935757139969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[order_date],[ship_date])' />
      </column>
      <column caption='Discount Bucket' datatype='string' name='[Calculation_1864935757570050]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [discount]&#10;WHEN 0 THEN &quot;0%&quot;&#10;WHEN 0.1 THEN &quot;1-20%&quot;&#10;WHEN 0.2 THEN &quot;1-20%&quot;&#10;WHEN 0.3 THEN &quot;21-40%&quot;&#10;WHEN 0.4 THEN &quot;21-40%&quot;&#10;ELSE &quot;41%+&quot;&#10;END' />
      </column>
      <column caption='Negative profit by sub-category' datatype='real' name='[Calculation_1864935762223107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [sub_category] : AVG([profit]) }' />
      </column>
      <column caption='high -ve values' datatype='string' name='[Calculation_1864935762583556]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1864935762223107] &lt; 0 THEN&#10;    &quot;Loss&quot;&#10;ELSE&#10;    &quot;Profit&quot;&#10;END' />
      </column>
      <column caption='order per customer' datatype='integer' name='[Calculation_1864935771582469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : COUNTD([order_id]) }' />
      </column>
      <column caption='customer type' datatype='string' name='[Calculation_1864935771701254]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1864935771582469] = 1 THEN&#10;    &quot;One-time&quot;&#10;ELSE&#10;    &quot;Repeat&quot;&#10;END' />
      </column>
